{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "noEmitOnError": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "../api/src/config/index.ts", "../api/src/lib/crawler.ts", "../api/src/lib/audit.ts", "../api/src/lib/ssrf.ts"],
  "exclude": ["node_modules", "dist"]
}
