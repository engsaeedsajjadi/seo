# private (default in docker-compose): one business uses SeoYar for its own customers — no paid plans,
# the first account is the owner and everyone else joins by invitation. saas: public sign-up with plans.
SEOYAR_MODE=private

# RankForge Environment Configuration
# Copy this file to .env and configure all required variables
# NEVER commit .env files with real secrets to version control

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
# فقط origin را بنویسید — کلاینت فرانت‌اند خودش /api/v1 را اضافه می‌کند.
# در حالت Docker (پشت پراکسی nginx) این مقدار را خالی بگذارید.
VITE_API_URL=http://localhost:3001

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://rankforge:password@localhost:5432/rankforge
DATABASE_PASSWORD=
# Database SSL is OFF by default — stock PostgreSQL (including the
# docker-compose postgres service) does not serve SSL. Set to true only
# when your (managed) PostgreSQL requires SSL connections.
DATABASE_SSL=false

# ============================================================
# REDIS (Job Queue & Cache)
# ============================================================
REDIS_URL=redis://:password@localhost:6379
REDIS_PASSWORD=your-redis-password

# ============================================================
# AUTHENTICATION
# ============================================================
JWT_SECRET=your-jwt-secret-min-32-chars-change-in-production
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
SESSION_SECRET=your-session-secret-min-32-chars

# ============================================================
# ENCRYPTION
# ============================================================
# Used for encrypting sensitive credentials at rest
ENCRYPTION_KEY=your-encryption-key-32-chars-min

# ============================================================
# SEO DATA PROVIDERS
# ============================================================

# DataForSEO (Primary: keywords, SERP, rankings, competitors, backlinks)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Alternative for Google rank checks: SerpApi, or a service with the same API format.
SERPAPI_KEY=
# Leave empty for https://serpapi.com; set it to use a compatible service.
SERPAPI_BASE_URL=
# KWRank (kwrank.ir), an Iranian rank tracker. Client Id and Secret come from its "API access" menu
# and need an active API plan. Keywords are registered there automatically and KWRank checks them daily.
KWRANK_CLIENT_ID=
KWRANK_CLIENT_SECRET=
# How deep to look for the site, 10 to 100 (default 50). Each 10 positions is one billed search,
# and the lookup stops as soon as the site is found.
RANK_CHECK_DEPTH=

# ============================================================
# AI PROVIDERS
# ============================================================

# OpenAI (GPT-4, GPT-4o)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google AI (Gemini)
GOOGLE_AI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
GOOGLE_AI_MODEL=

# OpenRouter (multi-model)
OPENROUTER_API_KEY=

# Perplexity (AI visibility tracking)
PERPLEXITY_API_KEY=

# ============================================================
# GOOGLE INTEGRATIONS
# ============================================================

# Google OAuth (for Search Console + GA4 data import)
# Create an OAuth 2.0 Web client in Google Cloud Console, enable the
# "Google Search Console API" and "Google Analytics Admin API" +
# "Google Analytics Data API", and register the redirect URI below as
# an Authorized redirect URI (it must match exactly).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to http://localhost:3001/api/v1/integrations/google/callback
# GOOGLE_REDIRECT_URI=https://api.your-domain.com/api/v1/integrations/google/callback
# NOTE: the worker (GSC_SYNC / GA4_SYNC jobs) needs the same
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET, plus the same ENCRYPTION_KEY
# (or JWT_SECRET) as the API — OAuth tokens are stored AES-256-GCM
# encrypted by the API and decrypted by the worker.

# Google PageSpeed Insights
PAGESPEED_API_KEY=

# ============================================================
# BILLING (Stripe)
# ============================================================
# Real payments: POST /api/v1/billing/checkout creates a Checkout
# Session (subscription) for the caller's organization, and
# POST /api/v1/billing/webhook applies signature-verified events
# (SDK constructEvent over the raw body) to plan/subscription state,
# invoices, and the monthly credit allotment.
# Without STRIPE_SECRET_KEY the billing endpoints report
# PROVIDER_NOT_CONFIGURED; without STRIPE_WEBHOOK_SECRET the webhook
# endpoint rejects every delivery (nothing is processed unverified).
#
# Setup (Stripe Dashboard, test mode first):
#   1. Products & Prices: create one Product per paid plan
#      (STARTER / PRO / AGENCY / ENTERPRISE), each with a monthly and
#      an annual recurring Price. Put the price ids in the plans
#      table (stripe_price_id_monthly / stripe_price_id_annual) OR
#      use the STRIPE_PRICE_* env fallback below — the column wins.
#   2. Webhooks: add an endpoint pointing at
#      https://<your-api-domain>/api/v1/billing/webhook with events:
#      checkout.session.completed, customer.subscription.created,
#      customer.subscription.updated, customer.subscription.deleted,
#      invoice.payment_succeeded, invoice.payment_failed.
#      Copy its Signing secret into STRIPE_WEBHOOK_SECRET.
#   3. API keys: Developers → API keys → copy the secret key into
#      STRIPE_SECRET_KEY (test mode: sk_test_... / whsec_...).
#   APP_URL (above) is the base for checkout success/cancel redirects
#   and the Customer Portal return URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Optional price-id fallback (plans table columns take precedence):
#STRIPE_PRICE_STARTER_MONTHLY=price_...
#STRIPE_PRICE_STARTER_ANNUAL=price_...
#STRIPE_PRICE_PRO_MONTHLY=price_...
#STRIPE_PRICE_PRO_ANNUAL=price_...
#STRIPE_PRICE_AGENCY_MONTHLY=price_...
#STRIPE_PRICE_AGENCY_ANNUAL=price_...
#STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
#STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...
# Test-only override of the Stripe API base URL (leave unset live):
#STRIPE_API_BASE_URL=https://api.stripe.com

# ============================================================
# STORAGE (S3-compatible)
# ============================================================
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rankforge-storage
S3_REGION=us-east-1

# ============================================================
# MONITORING & ANALYTICS
# ============================================================

# Sentry (error tracking)
SENTRY_DSN=

# PostHog (product analytics)
POSTHOG_KEY=

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# WORKER
# ============================================================
WORKER_CONCURRENCY=5
WORKER_TIMEOUT=300000

# ============================================================
# CRAWLER
# ============================================================
CRAWLER_MAX_CONCURRENCY=10
CRAWLER_DEFAULT_DELAY=1000
CRAWLER_USER_AGENT=SeoYarBot/1.0
CRAWLER_TIMEOUT=30000

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================================
# FEATURE FLAGS
# ============================================================
FEATURE_AI_ENABLED=true
FEATURE_GEO_ENABLED=true
FEATURE_AEO_ENABLED=true
FEATURE_ADVANCED_CRAWLING=true
FEATURE_MCP_ENABLED=true

# Worker database login. It is not the owner account. Use a long random value.
WORKER_DATABASE_PASSWORD=
# API database logins (not the owner). Use a long random value.
API_DATABASE_PASSWORD=

# Password recovery: authenticated SMTP URL and verified sender. Never commit real credentials.
SMTP_URL=
MAIL_FROM=

# Zarinpal: online payment in toman. APP_URL must be the public HTTPS address: the gateway
# returns customers to APP_URL/api/v1/billing/zarinpal/callback. Set ZARINPAL_SANDBOX=true to test.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# Platform operators (comma separated emails) and the /api/v1/metrics bearer token.
PLATFORM_ADMIN_EMAILS=
METRICS_TOKEN=
# Reverse proxies in front of the API. Wrong values break per-client rate limiting.
TRUST_PROXY_HOPS=1

# Private services bind to loopback by default. Use an HTTPS reverse proxy for public access.
DATABASE_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
MCP_BIND_ADDRESS=127.0.0.1
