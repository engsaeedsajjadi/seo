# RankForge — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/rankforge
DATABASE_MIGRATE_URL=postgresql://admin:password@localhost:5432/rankforge

# ============================================================
# AUTHENTICATION
# ============================================================
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (for GSC, GA4, and social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# SEO DATA PROVIDERS
# ============================================================

# DataForSEO (Primary SERP/Keywords/Backlinks provider)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Alternative: SerpApi
SERPAPI_KEY=

# ============================================================
# AI PROVIDERS
# ============================================================

# OpenAI (GPT-4, GPT-4o)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google AI (Gemini)
GOOGLE_AI_API_KEY=

# OpenRouter (multi-model access)
OPENROUTER_API_KEY=

# Perplexity (for AI visibility tracking)
PERPLEXITY_API_KEY=

# ============================================================
# PAYMENTS
# ============================================================

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ============================================================
# STORAGE
# ============================================================

# S3-compatible object storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rankforge-storage
S3_REGION=us-east-1

# ============================================================
# MONITORING & ANALYTICS
# ============================================================

# Sentry (error tracking)
SENTRY_DSN=

# PostHog (product analytics)
POSTHOG_KEY=

# ============================================================
# APPLICATION
# ============================================================

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Feature Flags
FEATURE_AI_ENABLED=true
FEATURE_GEO_ENABLED=true
FEATURE_AEO_ENABLED=true
FEATURE_ADVANCED_CRAWLING=true
FEATURE_MCP_ENABLED=true

# ============================================================
# WORKER
# ============================================================

# Worker concurrency
WORKER_CONCURRENCY=5
WORKER_TIMEOUT=300000

# Crawler settings
CRAWLER_MAX_CONCURRENCY=10
CRAWLER_DEFAULT_DELAY=1000
CRAWLER_USER_AGENT=RankForge/1.0

# ============================================================
# SECURITY
# ============================================================

# Encryption key for secrets at rest
ENCRYPTION_KEY=

# Rate limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGINS=http://localhost:3000
